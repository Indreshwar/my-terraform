pipeline{
    agent {
        label 'terraform'
    }
    parameters{
          choice(name: 'env', choices:['dev','non-prod','prod'], description:'choose the evironment to deploy')
    }
    stages{
        stage('git clone-ec2'){
           steps{
              sh '''
                rm -rf my-terraform
                 git clone --no-checkout https://github.com/Indreshwar/my-terraform.git 
                 cd my-terraform
                 git sparse-checkout init --cone 
                 git sparse-checkout set ec2
                 git checkout main 
              '''
              }
       }
    stage('trivy scan'){
        steps{
            dir('ec2') {
               sh 'trivy fs --format table -o ec2-report.txt . ' 
            }
        }
    }
    stage('terraform init'){
        steps{
           dir('ec2'){
             sh 'terraform init'
           }
       }
    }
    stage('terraform plan'){
        steps{
            dir('ec2'){
                sh 'terraform plan'
            }
        }
    }
    stage('terraform apply'){
        steps{
            dir('ec2'){
                sh 'terraform apply -auto-approve'
            }
        }
      }
    }
     post{
        success{
            echo "pipeine executed sucessfully"
        }
        failure{
            echo "pipeline failed"
        }
    }
}